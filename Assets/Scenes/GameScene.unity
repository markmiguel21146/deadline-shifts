--- !u!114 &1407964624
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1407964622}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc1a711bb6caee04f8041d63f5faafa8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCutscene
  cutscenePanel: {fileID: 1407964622}
  cutsceneCanvasGroup: {fileID: 1407964627}
  displayImage: {fileID: 1815939474}
  displayText: {fileID: 926735761}
  skipPromptText: {fileID: 0}
  slides:
  - slideImage: {fileID: 3044411825585286377, guid: 72b35ece86e64d679b89923058fc8ff9, type: 3}
    slideText: 'OCTOBER 1994.


      Deep beneath Sector 4 lies the classified archives
      of the Department of Metaphysical Sciences.'
    slideAudio: {fileID: 0}
  - slideImage: {fileID: -7117110007024914641, guid: f76e528609ec54f44a7f2f6188b34ef1, type: 3}
    slideText: 'Miles of magnetic tape. Thousands of redacted incident recordings.


      Night-shift
      transcribers work in total isolation, forbidden from questioning what they
      log.'
    slideAudio: {fileID: 0}
  - slideImage: {fileID: -3611744596757724476, guid: af7cd1c383d869d4e934b701c7cade57, type: 3}
    slideText: 'Late at night, the circuits decay.

      Monitors hum with voices
      found in no official log.


      If you look behind you... you might catch
      them watching.'
    slideAudio: {fileID: 0}
  - slideImage: {fileID: 3044411825585286377, guid: e1f9bc2a3a964cb78aa7c6ba30f82116, type: 3}
    slideText: 'Your shift begins at midnight.


      Meet your quota. Keep your
      eyes on the screen.

      And above all... do not let the lights go out.'
    slideAudio: {fileID: 0}
  charTypeSpeed: 0.038
  punctuationPause: 0.45
  autoAdvanceDelay: 3.2
  fadeDuration: 0.8
  audioSource: {fileID: 0}
  keystrokeSound: {fileID: 8300000, guid: 43554513f52c335408ba6696c2c15a8a, type: 3}
  slideTransitionSound: {fileID: 0}
  hallwaySequence: {fileID: 0}
  shiftTitleCard: {fileID: 668969781}
  forcePlayIntro: 1
